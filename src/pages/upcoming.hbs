<div class="page-header">
  <h1>{{title}}</h1>
  <a href="{{toggleHiddenUrl}}" class="page-header__toggle" title="Abandoned shows, and later seasons of shows you haven't started">
    {{#if showHidden}}Hide{{else}}Show{{/if}} abandoned &amp; not started
  </a>
</div>
{{#if error}}
  <p class="error">
    {{error}}
  </p>
{{else}}
  {{#if episodes}}
    <div style="margin-bottom: 50px">
      {{#each showDays}}
        {{> upcoming_episode showDay=this}}
      {{/each}}
    </div>

    {{> pagination pagination=pagination}}
  {{else}}
    <p>No upcoming episodes scheduled.</p>
  {{/if}}
{{/if}}
