<article class="search-result">
  <a
    class="search-result__poster"
    href="{{#if existsLocally}}/show/{{tvshow.id}}{{else}}{{tvshow.url}}{{/if}}"
    {{^if existsLocally}}target="_blank" rel="noopener"{{/if}}
    tabindex="-1"
    aria-hidden="true"
  >
    {{#if tvshow.image.medium}}
      <img src="{{tvshow.image.medium}}" alt="" />
    {{else}}
      <span class="search-result__no-poster">{{tvshow.name}}</span>
    {{/if}}
  </a>
  <div class="search-result__body">
    <h2 class="search-result__title">
      {{#if existsLocally}}
        <a href="/show/{{tvshow.id}}">{{tvshow.name}}</a>
      {{else}}
        <a href="{{tvshow.url}}" target="_blank" rel="noopener" title="View on TVMaze">{{tvshow.name}}</a>
      {{/if}}
    </h2>
    <div class="show-meta search-result__meta">
      {{#if tvshow.status}}
        <span class="show-status" data-status="{{tvshow.status}}">{{tvshow.status}}</span>
      {{/if}}
      {{#if years}}
        <span>{{years}}</span>
      {{/if}}
      {{#if tvshow.network.name}}
        <span>{{tvshow.network.name}}{{#if tvshow.network.country.code}} ({{tvshow.network.country.code}}){{/if}}</span>
      {{/if}}
      {{#if existsLocally}}
        <a href="{{tvshow.url}}" target="_blank" rel="noopener">TVMaze</a>
      {{/if}}
    </div>
    {{#if tvshow.summary}}
      <div class="search-result__summary">{{{tvshow.summary}}}</div>
    {{/if}}
    {{#if existsLocally}}
      <a href="/show/{{tvshow.id}}" class="search-result-action search-result-action--exists">
        In your library
      </a>
    {{else}}
      <form class="search-result__add" method="post" action="/admin/show/add/{{tvshow.id}}" onsubmit="this.querySelector('button').disabled = true">
        {{! filled in from TVMaze's genres, out in the open so nothing is posted that you didn't see }}
        <input class="search-result__tags" name="tags" value="{{suggestedTags}}" placeholder="#hashtags" aria-label="Hashtags for {{tvshow.name}}" />
        <button class="search-result-action search-result-action--add">Add show</button>
        <details class="search-result__note">
          <summary>Add a note</summary>
          <textarea name="description" placeholder="I can't wait to watch!" aria-label="Note for {{tvshow.name}}"></textarea>
        </details>
      </form>
    {{/if}}
  </div>
</article>
